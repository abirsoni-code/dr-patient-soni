rules_version = '2';

// All app reads/writes go through Cloud Functions using the Admin SDK,
// which bypasses these rules entirely. This blocks any direct client-side
// access to Firestore, so authorization stays centralized in dataEngine.cjs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
